# deploy.env.example — 設定雛形
# このファイルを deploy.env にコピーし、自分の値に書き換えてください。
# deploy.env は絶対に公開・コミットしないこと（権限 600 推奨）。
# 値はすべてプレースホルダです。

# ===== 必須 =====
# Discord Bot のトークン（Discord Developer Portal で発行）
DISCORD_TOKEN=your-discord-bot-token
# 応答対象のサーバー（guild）の ID
DISCORD_GUILD_ID=000000000000000000
# オーナー（あなた）のユーザー ID。DM 許可と /improve の認可に使う
DISCORD_OWNER_ID=000000000000000000

# ===== AI プロバイダ =====
# openai（OpenAI 互換 API）または codex（Codex CLI / ChatGPT ログイン）
AI_PROVIDER=openai
# AI_PROVIDER=openai のとき必須
AI_API_KEY=your-ai-api-key
# OpenAI 互換エンドポイントの URL
AI_BASE_URL=https://api.openai.com/v1
# 使用モデル名（プロバイダ側のモデルを指定）
AI_MODEL=your-model-name
# AI_PROVIDER=codex のときのみ: codex バイナリと認証ホーム
CODEX_BINARY=codex
CODEX_HOME=~/.codex

# ===== ペルソナ（Bot の自己認識。プロンプトへ組み込まれる） =====
# Bot が自分の名前として使う文字列
BOT_NAME=nezubot-discrod
# 自己紹介で言及するプロジェクト URL（任意。空なら言及しない）
BOT_REPO_URL=
# ライバル扱いするユーザー ID（任意。設定すると、その人にだけ好戦的に
# 接する例外がプロンプトに有効化される。空なら例外なし）
PERSONA_RIVAL_USER_ID=
# プロンプト内でライバルを指す呼び名
PERSONA_RIVAL_NAME=rival

# ===== データ配置 =====
# DB・ロック等のデータファイル置き場（空なら ~/.nezubot-discrod）
DATA_DIR=

# ===== 動作スイッチ =====
# サンドボックスでのコマンド実行を許可するか（既定は無効を推奨）
RUN_COMMAND_ENABLED=false
# 読み取り専用 Web ツール（検索・Wikipedia 等）を有効にするか
WEB_TOOLS_ENABLED=false

# ===== サンドボックス（run_command 用 Docker） =====
SANDBOX_IMAGE=discord-ai-sandbox:local
SANDBOX_TIMEOUT=15
SANDBOX_MEMORY=128m
SANDBOX_CPUS=0.5

# ===== サーバーログ RAG / 埋め込み =====
# 埋め込みの実行主体: 空 = Bot 内蔵 / off = 別プロセスのワーカーに任せる
SERVER_LOG_EMBEDDER=
# 埋め込みモデル（Hugging Face のモデル名）
SERVER_LOG_EMBEDDING_MODEL=intfloat/multilingual-e5-large
# ONNX モデルを直接読む場合のディレクトリ（任意。通常は空で fastembed が取得）
SERVER_LOG_EMBEDDING_ONNX_DIR=
# 静的蒸留ベクトルのモデルタグ（任意。使う場合のみ）
SERVER_LOG_STATIC_MODEL=
# ハイブリッド検索（任意）: 第2の埋め込みモデルを3本目の検索経路として
# 追加する。両方を設定したときだけ有効。未設定・モデルやベクトルが
# 使えない環境では、通常の2経路検索に自動でフォールバックする
SERVER_LOG_HYBRID_MODEL=
# 第2モデルの ONNX ディレクトリ（任意）
SERVER_LOG_HYBRID_ONNX_DIR=
# 埋め込み時の最大トークン長
SERVER_LOG_MAX_LENGTH=128

# ===== 自己改善 /improve（任意・オーナー専用） =====
# 空にすると無効
GITHUB_TOKEN=
# 改善 PR の対象リポジトリ（your-account/your-repo 形式）
SELF_REPO=
# ローカルチェックアウトのパス（任意）
SELF_CHECKOUT=
SELFMOD_IMAGE=discord-ai-selfmod:local
SELFMOD_ITERATIONS=30
SELFMOD_TIMEOUT=180

# ===== プロキシ（任意・特殊なネットワーク環境用） =====
# Discord への接続にプロキシが必要な環境でのみ設定
DISCORD_PROXY=
# プロキシ中継用の CA 証明書パス（必要な環境のみ）
DISCORD_PROXY_CA=
